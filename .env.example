APP_NAME=SearchIntel AI
APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_DB=searchintel
POSTGRES_USER=searchintel
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://searchintel:YOUR_POSTGRES_PASSWORD@localhost:5432/searchintel
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

ALLOW_LOCAL_URLS=false
CRAWLER_USER_AGENT=SearchIntelAI/0.1 (+local-development)
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_RESPONSE_BYTES=5000000
CRAWLER_MAX_CONCURRENCY=4
CRAWLER_REQUEST_DELAY_SECONDS=0.5

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_VERSION=bge-small-en-v1.5
VECTOR_STORE_PROVIDER=qdrant
QDRANT_COLLECTION=searchintel_chunks
BM25_TOP_K=20
DENSE_TOP_K=20
FUSION_TOP_K=20
RERANK_TOP_K=8
RERANKER_PROVIDER=noop
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_CONTEXT_MAX_CHARS=6000
LLM_PROVIDER=mock
# Generate a unique secret with: openssl rand -hex 32
AUTH_SECRET=
AUTH_COOKIE_SAMESITE=strict
AUTH_TOKEN_LIFETIME_SECONDS=3600
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=300
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW_SECONDS=3600
CRAWL_ENQUEUE_RATE_LIMIT=60
CRAWL_ENQUEUE_RATE_WINDOW_SECONDS=3600
AUDIT_ENQUEUE_RATE_LIMIT=30
AUDIT_ENQUEUE_RATE_WINDOW_SECONDS=3600
